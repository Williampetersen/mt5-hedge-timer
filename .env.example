# Copy this file to .env (scripts/setup.ps1 does it) and fill in the values.
# .env is gitignored: it never leaves this PC.

# MT5 account passwords (the master/trading password, NOT the investor password)
BUY_MT5_PASSWORD=
SELL_MT5_PASSWORD=

# Optional Telegram notifications. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
